# Copy to .env.local and fill in. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend)
RESEND_API_KEY=

# Protects /api/cron/nurture (Vercel Cron sends it automatically). Required.
CRON_SECRET=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=marcglocal.com,www.marcglocal.com

# Analytics
NEXT_PUBLIC_META_PIXEL_ID=

# Gemini (MSME checkup). Server-only.
GEMINI_API_KEY=
